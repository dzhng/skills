{
  "name": "skills-launch-video",
  "private": true,
  "type": "module",
  "scripts": {
    "audio": "node audio/synth.ts && node audio/master.ts",
    "studio": "remotion studio src/index.ts",
    "still": "remotion still src/index.ts --gl=angle",
    "draft": "remotion render src/index.ts LaunchVideo out/draft.mp4 --scale=0.5 --crf=24 --gl=angle",
    "render": "remotion render src/index.ts LaunchVideo out/skills-launch.mp4 --codec=h264 --crf=16 --audio-bitrate=320k --pixel-format=yuv420p --gl=angle"
  },
  "dependencies": {
    "@react-three/fiber": "^9.8.1",
    "@react-three/postprocessing": "^3.1.3",
    "@remotion/cli": "^4.0.529",
    "@remotion/google-fonts": "^4.0.529",
    "@remotion/three": "^4.0.529",
    "postprocessing": "^6.39.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "^4.0.529",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/three": "^0.186.0",
    "typescript": "^7.0.2"
  }
}
